pkgname=omacap
pkgver=@VERSION@
pkgrel=1
pkgdesc='Local screen recorder, screenshot tool and quick demo editor for Omarchy'
url='https://github.com/allisonmahmood/omacap'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'qt6-wayland' 'ffmpeg' 'python' 'python-dbus' 'python-gobject' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad-libs' 'gst-plugin-pipewire' 'xdg-desktop-portal' 'xdg-desktop-portal-hyprland' 'libpulse' 'wl-clipboard' 'grim' 'layer-shell-qt' 'libdeflate' 'wayland' 'tesseract' 'tesseract-data-eng')
makedepends=('cmake' 'ninja' 'wayland-protocols')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')
options=('!debug')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -S . -B build/package -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  cmake --build build/package
}
package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build/package
}
