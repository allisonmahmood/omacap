[Desktop Entry]
Type=Application
Name=OmaCap
GenericName=Screen recorder, screenshot tool and demo editor
Comment=Record or screenshot, then crop, style, annotate and export locally
Exec=omacap %f
Icon=omacap
Terminal=false
Categories=AudioVideo;Video;Recorder;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;image/png;image/jpeg;image/webp;
StartupNotify=true
StartupWMClass=omacap
Actions=record;

[Desktop Action record]
Name=Record screen
Exec=omacap --record
